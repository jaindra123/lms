<?php
/**
 * STAGING secrets — copy this file to  config.staging.php  on the staging
 * server ONLY, then fill in the real values.
 *
 *   cp config.staging.php.example config.staging.php
 *
 * config.staging.php is git-ignored and must never be committed.
 * $CFG is already initialised by config.php before this file is loaded.
 */

// Staging site URL (no trailing slash).
$CFG->wwwroot = 'https://staging.iiidem.in';

// Database connection.
$CFG->dbhost = '127.0.0.1';
$CFG->dbname = 'iiidem_stage';
$CFG->dbuser = 'iiidem_stage';
$CFG->dbpass = 'CHANGE_ME_STAGING_DB_PASSWORD';

// Moodle data directory for this environment.
$CFG->dataroot = '/var/moodledata_stage';
