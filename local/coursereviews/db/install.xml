<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/coursereviews/db" VERSION="2026060800" COMMENT="Enrolled student course reviews">
    <TABLES>
        <TABLE NAME="local_coursereviews" COMMENT="One review per user per course">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="rating" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="5"/>
                <FIELD NAME="reviewtext" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course_user_uix" UNIQUE="true" FIELDS="courseid, userid"/>
                <INDEX NAME="courseid_ix" UNIQUE="false" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
