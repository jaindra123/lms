{{!
    @template theme_iiidem2/pages/contact-us

    Public Contact Us page (/contact-us/).
}}
{{> theme_iiidem2/navbar }}

<main class="iiidem-marketing-page" id="main-content" tabindex="-1">

    <section class="iiidem-page-hero">
        <div class="container">
            <nav class="iiidem-breadcrumb" aria-label="Breadcrumb">
                <a href="{{config.wwwroot}}">{{#str}}home{{/str}}</a>
                <span aria-hidden="true">/</span>
                <span>{{pagetitle}}</span>
            </nav>
            <h1 class="iiidem-page-hero__title">{{pagetitle}}</h1>
            <p class="iiidem-page-hero__lead">{{pagesubtitle}}</p>
        </div>
    </section>

    <section class="iiidem-contact-section">
        <div class="container">
            <div class="row g-4">
                {{#hascontactinfo}}
                <div class="col-lg-5">
                    <div class="card iiidem-contact-card eci-card border-0 shadow-sm h-100">
                        <div class="card-body eci-card__body p-4">
                            <h2 class="h4 mb-4">{{#str}}contactus_getintouch, theme_iiidem2{{/str}}</h2>
                            {{#hasaddress}}
                            <div class="iiidem-contact-item mb-3">
                                <strong class="d-block text-muted small mb-1">{{#str}}address{{/str}}</strong>
                                <span>{{contactaddress}}</span>
                            </div>
                            {{/hasaddress}}
                            {{#hasemail}}
                            <div class="iiidem-contact-item mb-3">
                                <strong class="d-block text-muted small mb-1">{{#str}}email{{/str}}</strong>
                                <a href="{{contactemailurl}}">{{contactemail}}</a>
                            </div>
                            {{/hasemail}}
                            {{#hasphone}}
                            <div class="iiidem-contact-item">
                                <strong class="d-block text-muted small mb-1">{{#str}}phone{{/str}}</strong>
                                <a href="{{contactphoneurl}}">{{contactphone}}</a>
                            </div>
                            {{/hasphone}}
                        </div>
                    </div>
                </div>
                {{/hascontactinfo}}

                <div class="{{#hascontactinfo}}col-lg-7{{/hascontactinfo}}{{^hascontactinfo}}col-12 col-lg-8 mx-auto{{/hascontactinfo}}">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="h4 mb-4">{{#str}}contactus_sendmessage, theme_iiidem2{{/str}}</h2>
                            {{#formsent}}
                            <div class="alert alert-success" role="alert">
                                {{#str}}contactusformsent, theme_iiidem2{{/str}}
                            </div>
                            {{/formsent}}
                            <div class="iiidem-contact-form">
                                {{{formhtml}}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

<div class="d-none" aria-hidden="true">
    {{{ output.main_content }}}
</div>

{{#js}}
(function() {
    var form = document.querySelector('#contact-us-page form.mform');
    if (!form) {
        return;
    }

    var syncRequiredMarker = function(field) {
        if (!field || !field.name) {
            return;
        }

        var item = field.closest('.fitem');
        if (!item) {
            return;
        }

        var requiredIcon = item.querySelector('.form-label-addon .text-danger');
        if (!requiredIcon) {
            return;
        }

        var hasValue = field.value.trim() !== '';
        requiredIcon.classList.toggle('text-danger', !hasValue);
        requiredIcon.classList.toggle('text-success', hasValue);

        if (hasValue) {
            field.classList.remove('is-invalid');
            field.removeAttribute('aria-invalid');
            var feedback = item.querySelector('.form-control-feedback');
            if (feedback) {
                feedback.textContent = '';
                feedback.style.display = 'none';
            }
        }
    };

    form.querySelectorAll('input[aria-required="true"], textarea[aria-required="true"]').forEach(function(field) {
        syncRequiredMarker(field);
        field.addEventListener('input', function() {
            syncRequiredMarker(field);
        });
        field.addEventListener('blur', function() {
            syncRequiredMarker(field);
        });
    });
})();
{{/js}}

{{> theme_iiidem2/page_end }}
