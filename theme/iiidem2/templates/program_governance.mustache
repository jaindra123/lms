{{!
    @template theme_iiidem2/program_governance

    Program Governance advisors (data from Site administration → Theme → IIIDEM2 → Program Governance).
}}
<section class="iiidem-course-section advisors-section" id="program_governance">
    <div class="container">
        <header class="iiidem-course-section__header text-center mb-4 mb-md-5">
            <h2 class="iiidem-course-section__title">{{governancetitle}}</h2>
        </header>
        <div class="advisors-grid">
            {{#advisors}}
            <div class="advisor-card">
                <div class="advisor-image">
                    <img src="{{imageurl}}" alt="{{imagealt}}">
                </div>
                <div class="advisor-content">
                    <h3 class="iiidem-advisor__name">{{name}}</h3>
                    {{#hasrole1}}
                    <p class="iiidem-advisor__designation">{{role1}}</p>
                    {{/hasrole1}}
                    {{#hasrole2}}
                    <span class="iiidem-advisor__program-role">{{role2}}</span>
                    {{/hasrole2}}
                </div>
            </div>
            {{/advisors}}
        </div>
    </div>
</section>
