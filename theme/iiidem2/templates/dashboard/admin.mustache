{{!
    @template theme_iiidem2/dashboard/admin

    Admin dashboard cards — presentation only; URLs/strings unchanged.
}}
<div class="row g-4 admin-dashboard eci-dash-grid">
    <div class="col-12 col-md-6 col-xl-3">
        <article class="card h-100 eci-card shadow-sm border-0">
            <div class="card-body eci-card__body d-flex flex-column">
                <h2 class="h5 card-title">{{#str}}dashboardusers, theme_iiidem2{{/str}}</h2>
                <p class="card-text text-muted flex-grow-1">{{#str}}dashboardusers_desc, theme_iiidem2{{/str}}</p>
                <a class="btn btn-primary align-self-start" href="{{usersurl}}">{{#str}}view{{/str}}</a>
            </div>
        </article>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <article class="card h-100 eci-card shadow-sm border-0">
            <div class="card-body eci-card__body d-flex flex-column">
                <h2 class="h5 card-title">{{#str}}dashboardcourses, theme_iiidem2{{/str}}</h2>
                <p class="card-text text-muted flex-grow-1">{{#str}}dashboardcourses_desc, theme_iiidem2{{/str}}</p>
                <a class="btn btn-primary align-self-start" href="{{coursesurl}}">{{#str}}view{{/str}}</a>
            </div>
        </article>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <article class="card h-100 eci-card shadow-sm border-0">
            <div class="card-body eci-card__body d-flex flex-column">
                <h2 class="h5 card-title">{{#str}}dashboardsiteadmin, theme_iiidem2{{/str}}</h2>
                <p class="card-text text-muted flex-grow-1">{{#str}}dashboardsiteadmin_desc, theme_iiidem2{{/str}}</p>
                <a class="btn btn-outline-primary align-self-start" href="{{siteadminurl}}">{{#str}}view{{/str}}</a>
            </div>
        </article>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        {{#hasreports}}
        <article class="card h-100 eci-card shadow-sm border-0">
            <div class="card-body eci-card__body d-flex flex-column">
                <h2 class="h5 card-title">{{#str}}dashboardreports, theme_iiidem2{{/str}}</h2>
                <p class="card-text text-muted flex-grow-1">{{#str}}dashboardreports_desc, theme_iiidem2{{/str}}</p>
                <a class="btn btn-outline-primary align-self-start" href="{{reportsurl}}">{{#str}}view{{/str}}</a>
            </div>
        </article>
        {{/hasreports}}
    </div>
</div>

<section class="row g-4 mt-2 admin-dashboard-calendar" aria-label="{{#str}}dashboardcalendartitle, theme_iiidem2{{/str}}">
    <div class="col-12">
        {{> theme_iiidem2/dashboard/calendar_panel }}
    </div>
</section>
