{{!
    @template theme_iiidem2/footer

    Shared site footer — IIIDEM royal-blue brand lockup (logo + about + links + contact).
    Same markup on every layout via theme_iiidem2/page_end.
}}
{{#hasenrollmodal}}
{{!
    Enrollment modal (course pages only).
}}
<div class="modal fade" id="enrollModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Enrollment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}}closebuttontitle, core{{/str}}"></button>
            </div>
            <div class="modal-body">
                <p id="courseInfo"></p>
                <h1>7-day Free Trial</h1>
                <p class="text-muted">Do you want to enroll in this course?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelEnroll">{{#str}}cancel{{/str}}</button>
                <button type="button" class="btn btn-success" id="confirmEnroll">Start Free Trial</button>
            </div>
        </div>
    </div>
</div>
{{/hasenrollmodal}}

<footer class="iiidem-footer" role="contentinfo">
    <div class="container-fluid footer-full">
        <div class="row footer-contact g-4 g-lg-5">
            <div class="col-12 col-md-5 footer-col footer-col--about">
                <div class="footer-brand">
                    <a href="{{{ config.wwwroot }}}" class="footer-brand__link">
                        <img src="{{{footerlogourl}}}" alt="{{#str}}footerinstitutename, theme_iiidem2{{/str}}" class="footer-logo">
                    </a>
                </div>
                <p class="footer-brand__desc">{{{footeraboutdesc}}}</p>
            </div>

            <div class="col-12 col-md-3 footer-col footer-col--links">
                <h2 class="footer-col__heading">{{#str}}footerquicklinks, theme_iiidem2{{/str}}</h2>
                <ul class="footer-quick-links list-unstyled">
                    <li><a href="{{{ config.wwwroot }}}">{{#str}}home{{/str}}</a></li>
                    <li><a href="{{{ config.wwwroot }}}/about-us/">{{#str}}aboutus, theme_iiidem2{{/str}}</a></li>
                    <li><a href="{{{ config.wwwroot }}}/contact-us/">{{#str}}contactus, theme_iiidem2{{/str}}</a></li>
                    <li><a href="{{{ config.wwwroot }}}/course/index.php">{{#str}}mycourses{{/str}}</a></li>
                </ul>
            </div>

            <div class="col-12 col-md-4 footer-col footer-col--contact">
                {{#address}}
                <div class="loc"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <span>{{{address}}}</span></div>
                {{/address}}
                {{#phone}}
                <div class="telph"><i class="fa-solid fa-phone-volume" aria-hidden="true"></i> <a href="{{phoneurl}}">{{{phone}}}</a></div>
                {{/phone}}
                {{#email}}
                <div class="mail"><i class="fa-regular fa-envelope" aria-hidden="true"></i> <a href="{{emailurl}}">{{{email}}}</a></div>
                {{/email}}
            </div>
        </div>

        <div class="copyRights">
            <span>{{{copyrighttext}}}</span>
            <ul class="footer-social list-unstyled d-inline-flex mb-0">
                {{#facebookurl}}
                    <li><a href="{{facebookurl}}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a></li>
                {{/facebookurl}}
                {{#instagramurl}}
                    <li><a href="{{instagramurl}}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a></li>
                {{/instagramurl}}
                {{#twitterurl}}
                    <li><a href="{{twitterurl}}" target="_blank" rel="noopener noreferrer" aria-label="X"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a></li>
                {{/twitterurl}}
                {{#youtubeurl}}
                    <li><a href="{{youtubeurl}}" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a></li>
                {{/youtubeurl}}
            </ul>
        </div>
    </div>
</footer>

<footer id="page-footer" class="footer-popover bg-white d-none" aria-hidden="true">
    <div data-region="footer-container-popover" class="d-none">
        {{#output.has_communication_links}}
            <button type="button" onclick="window.open('{{output.communication_url}}', '_blank', 'noopener,noreferrer')" class="btn icon-no-margin btn-footer-communication bg-primary text-white" aria-label="{{#str}}communicationroomlink, course{{/str}}">
                {{#pix}}t/messages-o, core{{/pix}}
            </button>
        {{/output.has_communication_links}}
    </div>
    {{!
        Moodle system footer (login info, data retention, mobile app,
        switch theme, powered by Moodle) — hidden from the public UI.
        Page JS is output from theme_iiidem2/page_end (standard_end_of_body_html).
    }}
    <div class="footer-content-popover container d-none" data-region="footer-content-popover" hidden>
        <div class="footer-section p-3 border-bottom">
            <div class="logininfo">{{{ output.login_info }}}</div>
            <div class="tool_usertours-resettourcontainer"></div>
            {{{ output.standard_footer_html }}}
        </div>
        <div class="footer-section p-3">
            <div>{{#str}}poweredbymoodle, core{{/str}}</div>
            {{#output.moodle_release}}
                <div>{{#str}}version, core{{/str}} {{{ output.moodle_release }}}</div>
            {{/output.moodle_release}}
        </div>
    </div>
</footer>
