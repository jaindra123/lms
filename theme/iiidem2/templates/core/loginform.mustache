{{!
    @template core/loginform

    IIIDEM override — same Moodle login functionality, custom styling.
}}
<div class="loginform iiidem-loginform">
    {{#logourl}}
        <div id="loginlogo" class="login-logo iiidem-loginform__core-logo">
            <img id="logoimage" src="{{logourl}}" class="img-fluid" alt="{{sitename}}"/>
            <h1 class="login-heading sr-only">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
        </div>
    {{/logourl}}
    {{^logourl}}
        <h1 class="login-heading sr-only">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
    {{/logourl}}

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance" role="alert">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#error}}
        <div class="alert alert-danger iiidem-loginform__alert" id="loginerrormessage" role="alert">{{error}}</div>
    {{/error}}
    {{#info}}
        <div class="alert alert-info iiidem-loginform__alert" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form iiidem-loginform__form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            <div class="iiidem-loginform__field">
                <label for="username" class="iiidem-loginform__label">
                    {{^canloginbyemail}}{{#str}} username {{/str}}{{/canloginbyemail}}
                    {{#canloginbyemail}}{{#str}} usernameemail {{/str}}{{/canloginbyemail}}
                </label>
                <input type="text" name="username" id="username" class="form-control iiidem-loginform__input" value="{{username}}" autocomplete="username" placeholder="{{^canloginbyemail}}{{#cleanstr}}username{{/cleanstr}}{{/canloginbyemail}}{{#canloginbyemail}}{{#cleanstr}}usernameemail{{/cleanstr}}{{/canloginbyemail}}">
            </div>

            <div class="iiidem-loginform__field">
                <label for="password" class="iiidem-loginform__label">{{#str}} password {{/str}}</label>
                <div class="iiidem-loginform__password-wrap">
                    <input type="password" name="password" id="password" value=""
                           class="form-control iiidem-loginform__input"
                           placeholder="{{#cleanstr}}password{{/cleanstr}}"
                           autocomplete="current-password">
                    <button type="button"
                            class="iiidem-loginform__password-toggle"
                            id="iiidem-password-toggle"
                            aria-label="{{#str}}togglesensitive, form{{/str}}"
                            aria-pressed="false"
                            title="{{#str}}togglesensitive, form{{/str}}">
                        <span class="fa fa-eye-slash" aria-hidden="true" data-icon="hidden"></span>
                        <span class="fa fa-eye d-none" aria-hidden="true" data-icon="visible"></span>
                    </button>
                </div>
            </div>

            {{#recaptcha}}
                <div class="iiidem-loginform__field iiidem-loginform__recaptcha">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}

            <div class="iiidem-loginform__actions">
                <button class="btn btn-primary iiidem-loginform__submit" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
            </div>

            <div class="iiidem-loginform__forgot">
                <a href="{{forgotpasswordurl}}">{{#str}}forgotaccount{{/str}}</a>
            </div>
        </form>
    {{/showloginform}}

    {{#hasidentityproviders}}
        <div class="iiidem-loginform__divider" role="separator"></div>
        <div class="login-identityproviders iiidem-loginform__idps">
            <h2 class="iiidem-loginform__section-title">{{#str}} potentialidps, auth {{/str}}</h2>
            {{#identityproviders}}
                <a class="btn login-identityprovider-btn iiidem-loginform__idp-btn" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="24" height="24"/>
                    {{/iconurl}}
                    {{name}}
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}

    {{#hasinstructions}}
        <div class="iiidem-loginform__divider" role="separator"></div>
        <div class="login-instructions iiidem-loginform__instructions">
            <h2 class="iiidem-loginform__section-title">{{#str}}firsttime{{/str}}</h2>
            {{{instructions}}}
        </div>
    {{/hasinstructions}}

    <div class="iiidem-loginform__footer">
        {{#languagemenu}}
            <div class="login-languagemenu iiidem-loginform__lang">
                {{>core/action_menu}}
            </div>
        {{/languagemenu}}
        <button type="button" class="btn btn-link iiidem-loginform__cookies" data-modal="alert" data-modal-title-str='["cookiesenabled", "core"]' data-modal-content-str='["cookiesenabled_help_html", "core"]'>{{#str}}cookiesnotice{{/str}}</button>
    </div>
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    (function() {
        var input = document.getElementById('password');
        var btn = document.getElementById('iiidem-password-toggle');
        if (!input || !btn) {
            return;
        }
        // Prevent Moodle core ToggleSensitive from replacing this field.
        btn.addEventListener('click', function() {
            var show = input.getAttribute('type') === 'password';
            input.setAttribute('type', show ? 'text' : 'password');
            btn.setAttribute('aria-pressed', show ? 'true' : 'false');
            var hiddenIcon = btn.querySelector('[data-icon="hidden"]');
            var visibleIcon = btn.querySelector('[data-icon="visible"]');
            if (hiddenIcon && visibleIcon) {
                hiddenIcon.classList.toggle('d-none', show);
                visibleIcon.classList.toggle('d-none', !show);
            }
        });
    })();
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
    });
{{/js}}
