{{!

    @template theme_iiidem2/quiz/activity_wrapper



    Custom quiz summary (view) and fallback attempt wrapper.

}}

<div class="iiidem-quiz-mcq iiidem-quiz-activity{{#isquizviewpage}} iiidem-quiz-mcq--view{{/isquizviewpage}}" data-cmid="{{quizcmid}}">

    <div class="iiidem-quiz-mcq__stage">

        {{#hasquizbacklink}}

        <a href="{{quizbackurl}}" class="iiidem-quiz-mcq__back-link" title="{{#str}}back, moodle{{/str}}">
            <i class="icon fa fa-arrow-left" aria-hidden="true"></i>
            <span class="iiidem-quiz-mcq__back-label">{{#str}}back, moodle{{/str}}</span>
        </a>

        {{/hasquizbacklink}}

        <div class="iiidem-quiz-mcq__card"{{#hasquizwatermark}} style="--iiidem-quiz-watermark-url: url('{{quizwatermarkurl}}')"{{/hasquizwatermark}}>

            {{{ output.main_content }}}

        </div>

    </div>

</div>

