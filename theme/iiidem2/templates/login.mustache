{{!
    @template theme_iiidem2/login

    IIIDEM branded login page (split layout).
}}
{{> theme_iiidem2/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

{{{ output.standard_top_of_body_html }}}

<div id="page-wrapper" class="iiidem-login-shell">
    <div class="iiidem-login-layout"{{#hasloginbackground}} style="--iiidem-login-bg-image: url('{{loginbackgroundurl}}')"{{/hasloginbackground}}>
        <aside class="iiidem-login-layout__brand" aria-label="{{#str}}loginbrandpanel, theme_iiidem2{{/str}}">
            <a href="{{homeurl}}" class="iiidem-login-layout__brand-logo">
                {{#hasloginlogo}}
                    <img src="{{{loginlogo}}}" class="iiidem-login-layout__logo-img" alt="{{sitename}}">
                {{/hasloginlogo}}
                {{^hasloginlogo}}
                    <span class="iiidem-login-layout__logo-text">{{sitename}}</span>
                {{/hasloginlogo}}
            </a>

            <div class="iiidem-login-layout__brand-body">
                <p class="iiidem-login-layout__eyebrow">IIIDEM LMS</p>
                <h1 class="iiidem-login-layout__title">{{logintagline}}</h1>
                <ul class="iiidem-login-layout__features">
                    <li><i class="fa fa-graduation-cap" aria-hidden="true"></i><span>{{loginfeature1}}</span></li>
                    <li><i class="fa fa-video-camera" aria-hidden="true"></i><span>{{loginfeature2}}</span></li>
                    <li><i class="fa fa-certificate" aria-hidden="true"></i><span>{{loginfeature3}}</span></li>
                </ul>
            </div>

            <nav class="iiidem-login-layout__nav" aria-label="{{#str}}sitemenubar, admin{{/str}}">
                <a href="{{homeurl}}">{{#str}}home{{/str}}</a>
                <a href="{{abouturl}}">{{#str}}aboutus, theme_iiidem2{{/str}}</a>
                <a href="{{contacturl}}">{{#str}}contactus, theme_iiidem2{{/str}}</a>
            </nav>
        </aside>

        <main class="iiidem-login-layout__panel" id="region-main">
            <div class="iiidem-login-card">
                <header class="iiidem-login-card__header">
                    <h2 class="iiidem-login-card__title">{{loginwelcome}}</h2>
                    <p class="iiidem-login-card__subtitle">{{loginsubtitle}}</p>
                </header>

                <div class="iiidem-login-card__form">
                    {{{ output.main_content }}}
                </div>

                <p class="iiidem-login-signup text-center mb-0">
                    <span class="iiidem-login-signup__label">{{#str}}loginsignupprompt, theme_iiidem2{{/str}}</span>
                    <a href="{{registerurl}}" class="btn btn-outline-primary iiidem-btn iiidem-login-signup__btn">{{loginsignuplabel}}</a>
                </p>
            </div>
        </main>
    </div>
</div>

{{{ output.standard_end_of_body_html }}}

{{#js}}
M.util.js_pending('theme_iiidem2/loader');
require(['theme_iiidem2/loader'], function() {
    M.util.js_complete('theme_iiidem2/loader');
});
{{/js}}

</body>
</html>
