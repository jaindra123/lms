                            </span>
                            <span class="iiidem-curriculum-stat__body">
                                <span class="iiidem-curriculum-stat__label">{{#str}}curriculumtotalduration, theme_iiidem2{{/str}}</span>
                                <span class="iiidem-curriculum-stat__value">{{curriculumduration}}</span>
                            </span>
                        </div>
                        <div class="iiidem-curriculum-stat">
                            <span class="iiidem-curriculum-stat__icon iiidem-curriculum-stat__icon--green">
                                <span class="fa fa-play-circle" aria-hidden="true"></span>
                            </span>
                            <span class="iiidem-curriculum-stat__body">
                                <span class="iiidem-curriculum-stat__label">{{#str}}curriculumtotallectures, theme_iiidem2{{/str}}</span>
                                <span class="iiidem-curriculum-stat__value">{{#str}}curriculumlecturescount, theme_iiidem2, {{totalactivities}}{{/str}}</span>
                            </span>
                        </div>
                    </div> -->
                </header>

                {{#hascoursesummary}}
                <div class="iiidem-course-section__intro course-description">
                    {{{ coursesummary }}}
                </div>
                {{/hascoursesummary}}

                 <div class="iiidem-curriculum">
                    <div class="accordion iiidem-accordion" id="courseAccordion">
                        {{#sections}}
                        <div class="accordion-item">
                            <h3 class="accordion-header" id="heading{{id}}">
                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapse{{id}}"
                                        aria-expanded="false"
                                        aria-controls="collapse{{id}}">
                                    <span class="iiidem-accordion__label">
                                        <span class="iiidem-accordion__index" aria-hidden="true"></span>
                                        <span class="iiidem-accordion__heading">
                                            <span class="iiidem-accordion__title">{{name}}</span>
                                            {{#hassummary}}
                                            <span class="iiidem-accordion__subtitle">{{summary}}</span>
                                            {{/hassummary}}
                                        </span>
                                        <span class="iiidem-accordion__meta">{{#str}}curriculumlecturescount, theme_iiidem2, {{activitycount}}{{/str}}</span>
                                    </span>
                                </button>
                            </h3>

                            <div id="collapse{{id}}" class="accordion-collapse collapse" data-bs-parent="#courseAccordion">
                                <div class="accordion-body">
                                    {{#activities}}
                                    <div class="lecture-item">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <div class="iiidem-lecture-item__main">
                                                <span class="iiidem-lecture-item__icon" aria-hidden="true">
                                                    <span class="fa {{iconclass}}"></span>
                                                </span>
                                                <span class="iiidem-lecture-item__title">{{title}}</span>
                                            </div>
                                            <div class="iiidem-lecture-item__actions">
                                                {{#duration}}
                                                <span class="iiidem-lecture-item__duration">
                                                    <span class="fa fa-clock-o" aria-hidden="true"></span>{{duration}}
                                                </span>
                                                {{/duration}}
                                                {{#preview}}
                                                {{#canpreviewcurriculum}}
                                                <button class="btn btn-sm btn-primary iiidem-curriculum-preview-btn" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#preview{{id}}"
                                                        aria-expanded="false"
                                                        aria-controls="preview{{id}}"
                                                        data-cmid="{{cmid}}"
                                                        {{#trackcompletion}}data-trackcompletion="1"{{/trackcompletion}}
                                                        {{^trackcompletion}}data-trackcompletion="0"{{/trackcompletion}}>
                                                    <span class="fa fa-play me-1" aria-hidden="true"></span>{{previewlabel}}
                                                </button>
                                                {{/canpreviewcurriculum}}
                                                {{^canpreviewcurriculum}}
                                                {{#curriculumpreviewblocked}}
                                                <button type="button"
                                                        class="btn btn-sm btn-primary iiidem-curriculum-pay-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#iiidemPaymentRequiredModal"
                                                        data-scroll-target="#iiidem-course-fee">
                                                    <span class="fa fa-play me-1" aria-hidden="true"></span>{{previewlabel}}
                                                </button>
                                                {{/curriculumpreviewblocked}}
                                                {{^curriculumpreviewblocked}}
                                                {{#hasloginmodal}}
                                                <button type="button" class="btn btn-sm btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#iiidemLoginModal">
                                                    <span class="fa fa-play me-1" aria-hidden="true"></span>{{previewlabel}}
                                                </button>
                                                {{/hasloginmodal}}
                                                {{^hasloginmodal}}
                                                <a href="{{loginurl}}" class="btn btn-sm btn-primary">
                                                    <span class="fa fa-play me-1" aria-hidden="true"></span>{{previewlabel}}
                                                </a>
                                                {{/hasloginmodal}}
                                                {{/curriculumpreviewblocked}}
                                                {{/canpreviewcurriculum}}
                                                {{/preview}}
                                            </div>
                                        </div>

                                        {{#canpreviewcurriculum}}
                                        {{#haspreviewcontent}}
                                        <div class="collapse mt-2" id="preview{{id}}"
                                             data-cmid="{{cmid}}"
                                             {{#trackcompletion}}data-trackcompletion="1"{{/trackcompletion}}
                                             {{^trackcompletion}}data-trackcompletion="0"{{/trackcompletion}}>
                                            <div class="card card-body">
                                                {{{previewcontent}}}
                                            </div>
                                        </div>
                                        {{/haspreviewcontent}}
                                        {{/canpreviewcurriculum}}
                                    </div>
                                    {{/activities}}
                                </div>
                            </div>
                        </div>
                        {{/sections}}
                    </div>
                </div>
                
            </div>

            {{#hascoursefee}}
            <div class="col-lg-4 iiidem-course-content-layout__aside pay-now-sidebar">
                {{> theme_iiidem2/course/payment_sidebar }}
            </div>
            {{/hascoursefee}}

        </div>
    </div>

    <div class="iiidem-liveclass-modal"
         id="iiidem-liveclass-modal"
         hidden
         role="dialog"
         aria-modal="true"
         aria-labelledby="iiidem-liveclass-modal-title">
        <div class="iiidem-liveclass-modal__backdrop" data-action="close-liveclass-modal"></div>
        <div class="iiidem-liveclass-modal__dialog" role="document">
            <div class="iiidem-liveclass-modal__header">
                <h2 id="iiidem-liveclass-modal-title" class="iiidem-liveclass-modal__title">
                    {{#str}}liveclassmodaltitle, theme_iiidem2{{/str}}
                </h2>
                <button type="button"
                        class="iiidem-liveclass-modal__close"
                        data-action="close-liveclass-modal"
                        aria-label="{{#str}}closebuttontitle, core{{/str}}">
                    &times;
                </button>
            </div>
            <div class="iiidem-liveclass-modal__body">
                <div class="iiidem-liveclass-modal__frame-wrap">
                    <iframe class="iiidem-liveclass-modal__frame"
                            title="{{#str}}liveclassmodaltitle, theme_iiidem2{{/str}}"
                            allow="camera; microphone; display-capture; autoplay; fullscreen"
                            allowfullscreen></iframe>
                    <div class="iiidem-liveclass-modal__fallback" hidden>
                        <p class="iiidem-liveclass-modal__fallback-text">
                            {{#str}}liveclassmodalblocked, theme_iiidem2{{/str}}
                        </p>
                        <button type="button"
                                class="iiidem-live-class__join-btn iiidem-liveclass-modal__fallback-btn"
                                data-action="open-liveclass-window">
                            {{#str}}liveclassmodalopenexternal, theme_iiidem2{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{{#js}}
(function() {
    if (window.iiidemLiveClassModalBound) {
        return;
    }
    window.iiidemLiveClassModalBound = true;

    var activeUrl = '';
    var lastFocus = null;
    var fallbackTimer = null;

    function getModal() {
        return document.getElementById('iiidem-liveclass-modal');
    }

    function openWindow(url) {
        var width = Math.min(1200, window.screen.availWidth - 40);
        var height = Math.min(800, window.screen.availHeight - 80);
        var left = Math.max(0, Math.round((window.screen.availWidth - width) / 2));
        var top = Math.max(0, Math.round((window.screen.availHeight - height) / 2));
        window.open(url, 'iiidemLiveClass',
            'width=' + width + ',height=' + height + ',left=' + left + ',top=' + top +
            ',resizable=yes,scrollbars=yes,noopener,noreferrer');
    }

    function closeModal() {
        var modal = getModal();
        if (!modal) {
            return;
        }
        if (fallbackTimer) {
            window.clearTimeout(fallbackTimer);
            fallbackTimer = null;
        }
        modal.hidden = true;
        document.body.classList.remove('iiidem-liveclass-modal-open');
        var frame = modal.querySelector('.iiidem-liveclass-modal__frame');
        if (frame) {
            frame.removeAttribute('src');
        }
        var fallback = modal.querySelector('.iiidem-liveclass-modal__fallback');
        if (fallback) {
            fallback.hidden = true;
        }
        activeUrl = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
            lastFocus.focus();
        }
    }

    function openModal(url) {
        var modal = getModal();
        var frame = modal ? modal.querySelector('.iiidem-liveclass-modal__frame') : null;
        if (!modal || !frame || !url) {
            if (url) {
                openWindow(url);
            }
            return;
        }
        lastFocus = document.activeElement;
        activeUrl = url;
        var fallback = modal.querySelector('.iiidem-liveclass-modal__fallback');
        if (fallback) {
            fallback.hidden = true;
        }
        frame.src = url;
        modal.hidden = false;
        document.body.classList.add('iiidem-liveclass-modal-open');
        var closeButton = modal.querySelector('[data-action="close-liveclass-modal"]');
        if (closeButton) {
            closeButton.focus();
        }
        fallbackTimer = window.setTimeout(function() {
            if (fallback) {
                fallback.hidden = false;
            }
        }, 1800);
    }

    document.addEventListener('click', function(event) {
        var openButton = event.target.closest('[data-action="open-liveclass-modal"]');
        if (openButton) {
            event.preventDefault();
            openModal(openButton.getAttribute('data-join-url') || '');
            return;
        }
        if (event.target.closest('[data-action="close-liveclass-modal"]')) {
            event.preventDefault();
            closeModal();
            return;
        }
        if (event.target.closest('[data-action="open-liveclass-window"]')) {
            event.preventDefault();
            if (activeUrl) {
                openWindow(activeUrl);
            }
        }
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeModal();
        }
    });
}());
{{/js}}
