    <div class="container">
        <div class="row g-4 iiidem-course-content-layout">
            <div class="col-lg-{{#hascoursefee}}8{{/hascoursefee}}{{^hascoursefee}}12{{/hascoursefee}} iiidem-course-content-layout__main">
                <header class="iiidem-curriculum-header">
                    <div class="iiidem-curriculum-header__intro">
                        <h2 class="iiidem-curriculum-header__title">{{#str}}coursecontentheading, theme_iiidem2{{/str}}</h2>
                       <!--  <p class="iiidem-curriculum-header__subtitle">{{#str}}curriculumintro, theme_iiidem2{{/str}}</p> -->
                    </div>
