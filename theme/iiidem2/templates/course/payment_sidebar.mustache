{{!
    @template theme_iiidem2/course/payment_sidebar

    Course fee with PNB (test), ICICI (live), and Razorpay payment buttons.
}}
<div class="course-sidebar" id="iiidem-course-fee">
    <div class="iiidem-course-payment-card card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="iiidem-course-payment-card__price">{{coursefeecost}}</div>
            <p class="iiidem-course-payment-card__label">{{#str}}coursefeepaymentlabel, theme_iiidem2{{/str}}</p>

            {{#showcoursepayment}}
            <div class="d-grid gap-2 iiidem-course-payment-card__actions">
                {{#haspnbgateway}}
                <button type="button"
                        class="btn btn-primary btn-lg w-100 iiidem-course-payment-card__btn"
                        data-action="theme_iiidem2/triggerCoursePayment"
                        data-gateway="pnb"
                        data-component="enrol_fee"
                        data-paymentarea="fee"
                        data-itemid="{{coursefeeinstanceid}}"
                        data-description="{{coursefeedescription}}">
                    {{#str}}paywithpnb, theme_iiidem2{{/str}}
                </button>
                {{/haspnbgateway}}
                {{#hasicicigateway}}
                <button type="button"
                        class="btn btn-outline-primary btn-lg w-100 iiidem-course-payment-card__btn"
                        data-action="theme_iiidem2/triggerCoursePayment"
                        data-gateway="icici"
                        data-component="enrol_fee"
                        data-paymentarea="fee"
                        data-itemid="{{coursefeeinstanceid}}"
                        data-description="{{coursefeedescription}}">
                    {{#str}}paywithicici, theme_iiidem2{{/str}}
                </button>
                {{/hasicicigateway}}
                {{#hasrazorpaygateway}}
                <button type="button"
                        class="btn btn-success btn-lg w-100 iiidem-course-payment-card__btn"
                        data-action="theme_iiidem2/triggerCoursePayment"
                        data-gateway="razorpay"
                        data-component="enrol_fee"
                        data-paymentarea="fee"
                        data-itemid="{{coursefeeinstanceid}}"
                        data-description="{{coursefeedescription}}">
                    {{#str}}paywithrazorpay, theme_iiidem2{{/str}}
                </button>
                {{/hasrazorpaygateway}}
            </div>
            <p class="iiidem-course-payment-card__note small text-muted mt-3 mb-0">
                {{#str}}coursefeepaymentnote, theme_iiidem2{{/str}}
            </p>
            {{#js}}
            require(['theme_iiidem2/course_payment'], function(mod) {
                mod.init();
            });
            {{/js}}
            {{/showcoursepayment}}

            {{^showcoursepayment}}
            <p class="small text-muted mb-0">{{#str}}coursefeepaymentpending, theme_iiidem2{{/str}}</p>
            {{/showcoursepayment}}
        </div>
    </div>
</div>
