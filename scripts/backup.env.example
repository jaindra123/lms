# Copy to /etc/iiidem/backup.env and chmod 600 (NOT inside the web root).
# Staging — moodledata is a sibling of lms_stage, not inside it.

SITE_ROOT=/var/www/html/lms_stage
MOODLEDATA=/var/www/html/moodledata_stage
BACKUP_ROOT=/var/backups/iiidem
KEEP_DAYS=7
INCLUDE_MOODLEDATA=1

DB_HOST=10.247.137.82
DB_NAME=lms_stage
DB_USER=stage_user
DB_PASS=STAGING_DB_PASSWORD