# Production — copy to /etc/iiidem/backup.env on the PRODUCTION host only.
# chmod 600. Do NOT use staging paths (lms_stage) on this server.

SITE_ROOT=/var/www/html/lms
MOODLEDATA=/var/www/html/moodledata
# If dataroot differs, match $CFG->dataroot from production config.php exactly.
BACKUP_ROOT=/var/backups/iiidem
KEEP_DAYS=7
INCLUDE_MOODLEDATA=1

DB_HOST=...
DB_NAME=...
DB_USER=...
DB_PASS=...

# Only if mysqldump is not on PATH after install:
# MYSQLDUMP_BIN=/usr/bin/mysqldump
